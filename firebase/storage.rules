rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && request.auth.token.get('admin',false) == true; }
    match /videos/{videoId}/{version} {
      allow read: if admin() || (request.auth != null &&
        firestore.exists(/databases/(default)/documents/videos/$(videoId)) &&
        firestore.get(/databases/(default)/documents/videos/$(videoId)).data.publicado == true &&
        firestore.get(/databases/(default)/documents/videos/$(videoId)).data.storagePath == 'videos/' + videoId + '/' + version);
      allow create, update: if admin() && request.resource.size > 0 && request.resource.size <= 1073741824 && request.resource.contentType.matches('video/.*');
      allow delete: if admin();
    }
  }
}
